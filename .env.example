# Campus Customs — environment variables
# Copy this file to ".env" (in this same hw4/ folder) and fill in your real key.
# The real .env is git-ignored and must never be committed.

# Portkey API key that powers the AI shopping assistant.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown):
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# CAMPUS_CUSTOMS_MODEL=gpt-5.6-terra
